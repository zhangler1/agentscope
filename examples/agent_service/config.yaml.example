# ==========================================================
# BocomADP 配置模板（复制为 config.yaml 后按需修改）
# cp config.yaml.example config.yaml
#
# 本文件为唯一配置源模板：框架级参数（logging/service/redis/
# tools/middlewares/mcp/providers）与业务配置（models/
# app_name/workspace_dir）统一在此声明。
# 读取优先级：进程环境变量（BOCOMADP_*）> .env > config.yaml > 代码默认值
# ==========================================================

# ---------- 服务 ----------
# Web UI 标题与健康检查展示的应用名
app_name: "交通银行智能体平台"

# ---------- 日志 ----------
log_level: info
logging:
  enhance:
    enabled: true
    format: text           # text | json

# ---------- HTTP 服务 ----------
service:
  host: 0.0.0.0
  port: 8000
  reload: false            # 仅开发期开启自动重载

# ---------- 上下文压缩（统一压缩模型） ----------
# 所有会话的上下文压缩统一使用指定凭证 + 模型（框架压缩本身默认开启）。
# enabled: false（默认）时中间件纯透传，压缩用各会话自身模型（现状）；
# enabled: true 时两个模型字段必填（缺一启动报错）。
# 凭证 ID 由使用方提供（代码只按 ID 查库，不做凭证创建）。
# 压缩参数（trigger/reserve/提示词）仍由各智能体 context_config 自定义，此处不配。
context_compression:
  enabled: false
  credential_id: "deerflow-lwh-deepseek-v4-flash"
  model_name: "deepseek-v4-flash"

# ---------- Redis（AgentScope storage / message bus） ----------
redis:
  host: localhost
  port: 6379

# ---------- 组件注册表 ----------
tools:
  enabled: true
  load_custom: true

middlewares:
  enabled: true
  load_custom: true

mcp:
  enabled: true
  load_custom: true

# ---------- 模型 Provider ----------
providers:
  enabled: true
  config_file: null        # null 表示使用本文件

models:
  - provider_id: deepseek
    display_name: "DeepSeek Chat"
    provider_type: deepseek
    model_name: deepseek-chat
    api_key: ${DEEPSEEK_API_KEY}
    base_url: https://api.deepseek.com
    is_active: true
    supports_multimodal: false
    parameters:
      temperature: 0.7
      max_tokens: 4096
      thinking_enable: false

# ---------- 运行时目录 ----------
# 工作区目录（AgentScope 沙箱文件读写根目录），支持 $VAR 展开
workspace_dir: "./workspaces"

# ---------- 跨知识搜索（cross_search 工具） ----------
# 扁平结构：键与 bocomadp/config/cross_search_config.py 字段一一对应。
# 字符串值支持 $VAR / ${VAR} 环境变量引用展开（如 api_url: $CROSS_SEARCH_API_URL）。
cross_search:
  # api_url 支持环境变量引用展开，运行时需设置 CROSS_SEARCH_API_URL
  api_url: $CROSS_SEARCH_API_URL
  timeout: 30
  caller: "VD2026000"          # 调用方编码，必填
  search_type: "0"             # 0=混合检索 1=全文 2=向量
  text_top_n: 5
  vector_top_n: 5
  qa_type: [0, 1]
  attach_flag: 1
  rerank_flag: 1
  rewrite_flag: "ON"
  rerank_top_n: 5
  rerank_rule_code: "RR0005"
  vector_min_score: 0.54
  user_role: "0"
  user_code: "U000000000000000"         # 调用方用户编码，必填
  psnl_space_code_id: "PER754964863350213"
  space_code_list: []          # 场景知识空间代码列表
  team_space_code_list: []     # 团队知识空间代码列表
  psnl_category_id_list: []
  second_search_kb_codes: []   # 二次检索的知识库代码（可选）
  headers:
    Accept: "*/*"
    Accept-Encoding: "gzip, deflate, br"
    Connection: "keep-alive"
    Content-Type: "multipart/form-data"
    jumpcloud-ENV: "BASE"


# ---------- 联网搜索（online_search，含 custom_search 请求逻辑） ----------
# 扁平结构：键与 online_search_config.py 字段一一对应。
online_search:
  api_url: $CUSTOM_SEARCH_API_URL   # 环境变量展开，运行时需设置
  timeout: 30
  max_results: 5

# ---------- 个人知识库搜索（personal_search） ----------
personal_search:
  api_url: $PERSONAL_SEARCH_API_URL  # 必填，请求地址
  timeout: 30                         # 请求超时(秒)
  source_type: "WDZS"                 # 请求体 sourceType
  repository: "personal-search"       # 请求体 repository
  search_type: "0"                    # 请求体 searchType
  headers:                            # 可选：合并覆盖默认头
    jumpCloud-Env: "BASE"

# ---------- 行内搜索（vector_search） ----------
vector_search:
  api_url: $VECTOR_SEARCH_API_URL
  timeout: 30
  page_size: 10
  text_top_n: 7
  vector_top_n: 10
  space_codes: ["SP0999999", "SP0000214"]


# ---------- 文件上传能力 ----------
# 非图片文件上传 / 格式转换（-> Markdown）/ 上下文注入。
# base_dir 为独立上传根（不挂在 workspace 下），相对路径基于 BASE_DIR 归一化。
# 支持文本/代码、PDF、Word、PPT、Excel、HTML 转 .md；图片在接口层拒绝；
# 其余格式（压缩包等）暂不支持。
uploads:
  enabled: true
  base_dir: "./uploads"          # 上传文件根目录 {base}/{user_id}/sessions/{session_id}/files/
  max_file_size_mb: 50.0         # 单文件大小上限（MB）
  max_files_per_session: 50       # 单会话最大文件数
  streaming_threshold_mb: 10.0    # 超过此阈值走流式/分块上传（MB）
  max_pdf_pages: 1000            # PDF 页数上限（超出拒绝）
  max_filename_length: 255       # 文件名最大长度
