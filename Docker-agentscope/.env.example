# ==========================================================
# Docker-agentscope 环境配置示例
# 复制为 .env 后按需修改：cp .env.example .env
# 本文件被 docker-compose.yml 的 agentscope-service 通过 env_file 注入。
# ==========================================================

# ---------- Agent Service（官方 main.py 读取） ----------
# Redis 地址/端口（compose 已用 environment 强制 REDIS_HOST=redis，
# 这里可覆盖端口等）
REDIS_PORT=6379

# [可选] 高德地图 MCP Key：设置后 agent_service 会额外挂载 amap MCP
# AMAP_API_KEY=

# [可选] ClawHub 技能市场 token（提高拉取技能限流上限）
# CLAWHUB_API_TOKEN=

# ---------- 企业扩展（原 bankcomm_adp，已整合进 bocomadp） ----------
# 企业配置（app_name / workspace_dir）统一读 agent_service/config.yaml，
# 本文件仅提供 config.yaml 中 $VAR / ${VAR} 引用的取值来源。
# 模型 API Key（供 config.yaml 的 ${DEEPSEEK_API_KEY} 展开使用）
# DEEPSEEK_API_KEY=
# 搜索/联机工具接口地址（供 config.yaml 的 $VAR 展开使用；
# 不设置时对应工具调用会报“API URL 未配置”）
# CROSS_SEARCH_API_URL=
# CUSTOM_SEARCH_API_URL=
# PERSONAL_SEARCH_API_URL=
# VECTOR_SEARCH_API_URL=
# RAW_REQUEST_API_URL=
# CONTACT_SEARCH_API_URL=
# PHYSICAL_CONTACT_SEARCH_API_URL=
