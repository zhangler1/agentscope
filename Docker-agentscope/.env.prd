# AgentScope K8s 沙箱配置
ADP_K8S_KUBECONFIG=/app/kubeconfig/config
ADP_K8S_ENABLED=true

# 共享 PVC 模式（仅 agent 级 RWX PVC，session 路径隔离）
ADP_K8S_DUAL_PVC_ENABLED=false
ADP_K8S_SHARED_PVC_ENABLED=true

ADP_K8S_NAMESPACE=agentscope
ADP_K8S_IMAGE=docker.io/library/agentscope-k8s-workspace:latest	
ADP_K8S_STORAGE_SIZE=500Mi
ADP_K8S_TTL=7200
ADP_K8S_POOL_IDLE_TTL=7200
ADP_K8S_SWEEP_INTERVAL=30
ADP_K8S_MAX_ACTIVE_PODS=1
ADP_K8S_IMAGE_PULL_POLICY=IfNotPresent

# Redis — 由 docker-compose environment 覆盖为 redis
REDIS_HOST=redis
REDIS_PORT=6379

# 关闭管控中间件（简化测试）
ADP_AUDIT_ENABLED=false
ADP_DLP_ENABLED=false

SKILLHUB_CHANNEL_RAND=ygzzfyzh
# 登录请求体里的 platform / platForm 取值（另一环境为 BOCOMCODE）
SKILLHUB_PLATFORM=BOCOMWORK
BOCOMADP_EXTERNAL_SKILLHUB_URL=http://klbs-glb-slb-7003.bocomm.com/skillhub-web
ADP_TOOL_CALL_REPAIR=1