# =============================================================================
# bocom-starter 环境变量示例（全部可注释/省略，均有默认值）
# =============================================================================

# --- agentscope 官方配置（main.py storage/workspace 使用）------------------
# Redis 地址（应用主存储：会话、凭证等）。
# 本地直跑默认 localhost；Docker 部署时生产 Redis 由平台环境变量
# REDIS_HOST / REDIS_PORT 注入（compose environment 优先于本文件）
REDIS_HOST=localhost
REDIS_PORT=6379

# --- 行内模型平台配置（bocom-as/config，环境变量热读）---------------------
# 行内模型平台使用的 Redis（默认与主存储同实例，可独立指定）
# Docker 部署时同样由平台注入 ELLM_REDIS_HOST / ELLM_REDIS_PORT
ELLM_REDIS_HOST=localhost
ELLM_REDIS_PORT=6379
# Redis 连接超时（秒）与连接池上限
# ELLM_REDIS_TIMEOUT=1.0
# ELLM_REDIS_MAX_CONNECTIONS=200

# 模型 think-tag 表 Redis key（保持 bocomadp 历史 key，数据无缝兼容；
ELLM_MODEL_THINK_TAG_KEY=bocomadp:model:think_tag

# api_key 提前刷新窗口（秒）：过期时间前 120s 即触发惰性刷新
ELLM_KEY_REFRESH_AHEAD_SECS=120
