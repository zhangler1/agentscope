# =============================================================================
# bocom-starter 环境变量示例（全部可注释/省略，均有默认值）
# =============================================================================

# --- 数据库（应用主存储：会话、凭证、Agent 等）----------------------------
# SQLAlchemy async URL（AsyncSQLAlchemyStorage；OceanBase 兼容 MySQL 协议，
# 驱动 aiomysql，切真 OB 只改地址不改协议）。本地直跑默认 localhost:3306
# （main.py 代码默认值）；Docker 部署时生产数据库由平台环境变量 DB_URL
# 注入（compose environment 优先于本文件）。
DB_URL=mysql+aiomysql://agentscope:agentscope@host.docker.internal:3306/agentscope
